<Page x:Class="BleHid.App.Views.CapturePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:BleHid.App.Converters"
      xmlns:l="clr-namespace:BleHid.App.Localization"
      xmlns:core="clr-namespace:BleHid.Core;assembly=BleHid.Core"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{l:Tr app.nav.capture}">

  <Page.Resources>
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  </Page.Resources>

  <StackPanel Margin="24,0,24,24">

      <ui:TextBlock Text="{l:Tr app.nav.capture}" FontTypography="TitleLarge" Margin="0,0,0,4" />
      <ui:TextBlock Text="{l:Tr app.capture.description}"
                    FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" Margin="0,0,0,20" />

      <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,16"
                  Title="{l:Tr app.capture.redirecting.title}"
                  Message="{l:Tr app.capture.redirecting.message}"
                  IsOpen="{Binding IsRedirecting}" />

      <ui:InfoBar x:Name="NoHostsBar" Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                  Title="{l:Tr app.capture.noHosts.title}"
                  Message="{l:Tr app.capture.noHosts.message}" />

      <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}" Margin="0,0,0,16">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="{l:Tr app.capture.toggle}" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding Target, Converter={l:Format app.capture.sendingTo}}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch x:Name="CaptureToggle"
                         IsChecked="{Binding IsCapturing, Mode=OneWay}"
                         IsEnabled="{Binding CanCapture}"
                         Click="OnToggleCapture" />
      </ui:CardControl>

      <ui:InfoBar Severity="Warning" IsClosable="False" Margin="0,0,0,16"
                  Title="{l:Tr app.capture.lockWarning}"
                  Message="{Binding TargetLockWarning, Mode=OneWay}"
                  IsOpen="{Binding HasTargetLockWarning, Mode=OneWay}" />

      <ui:TextBlock Text="{l:Tr app.capture.sendInputTo}" FontTypography="Subtitle" Margin="0,0,0,8" />

      <ItemsControl ItemsSource="{Binding Targets}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:CardControl Margin="0,0,0,8">
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" />
                  <ui:TextBlock Text="{Binding Detail}" FontTypography="Caption" TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </ui:CardControl.Header>
              <RadioButton GroupName="InputTarget"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           Checked="OnTargetChecked" />
            </ui:CardControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ui:TextBlock Text="{l:Tr app.capture.pointer}" FontTypography="Subtitle" Margin="0,20,0,8" />

      <ui:CardControl Icon="{ui:SymbolIcon Timer24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Text="{l:Tr app.capture.pointerInterval.title}" FontTypography="BodyStrong" />
            <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Text="{Binding LinkIntervalMs, Converter={l:Format app.capture.pointerInterval.description}}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Slider Width="160" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center"
                  Value="{Binding PointerIntervalMs, Mode=TwoWay}" />
          <ui:TextBlock Width="52" Margin="12,0,0,0" VerticalAlignment="Center"
                        Text="{Binding PointerIntervalMs, Converter={l:Format app.capture.milliseconds}}" />
        </StackPanel>
      </ui:CardControl>

      <ui:TextBlock Text="{l:Tr app.capture.shortcuts}" FontTypography="Subtitle" Margin="0,20,0,8" />

      <ui:CardControl Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,0,8">
        <ui:CardControl.Header>
          <ui:TextBlock Text="{l:Tr app.capture.switchTarget}" FontTypography="BodyStrong" />
        </ui:CardControl.Header>
        <StackPanel MaxWidth="240">
          <ui:TextBlock Text="{x:Static core:Shortcuts.SwitchTargetSpaced}" FontFamily="Cascadia Mono, Consolas"
                        FontTypography="Body" TextWrapping="Wrap" />
          <ui:TextBlock Text="{Binding Source={x:Static core:Shortcuts.SwitchTargetAlternativeSpaced}, Converter={l:Format app.capture.switchShortcutAlternative}}" FontFamily="Cascadia Mono, Consolas"
                        FontTypography="Body" TextWrapping="Wrap" Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ui:CardControl>

      <ui:CardControl Icon="{ui:SymbolIcon Dismiss24}">
        <ui:CardControl.Header>
          <ui:TextBlock Text="{l:Tr app.capture.stop}" FontTypography="BodyStrong" />
        </ui:CardControl.Header>
        <ui:TextBlock Text="{x:Static core:Shortcuts.StopSpaced}" FontFamily="Cascadia Mono, Consolas"
                      FontTypography="Body" />
      </ui:CardControl>

  </StackPanel>
</Page>
