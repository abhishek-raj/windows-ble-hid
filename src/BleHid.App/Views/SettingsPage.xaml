<Page x:Class="BleHid.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:BleHid.App.Localization"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{l:Tr app.nav.settings}">

  <StackPanel Margin="24,0,24,24">

    <ui:TextBlock Text="{l:Tr app.nav.settings}" FontTypography="TitleLarge" Margin="0,0,0,4" />
    <ui:TextBlock Text="{l:Tr app.settings.description}"
                  FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" Margin="0,0,0,20" />

    <ui:InfoBar x:Name="DevBar" Severity="Informational" IsClosable="False" Margin="0,0,0,16"
                Title="{l:Tr app.settings.autoStartUnavailable.title}"
                Message="{l:Tr app.settings.autoStartUnavailable.message}" />

    <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="{l:Tr app.settings.startWithWindows.title}" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{l:Tr app.settings.startWithWindows.description}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="AutoStartToggle" Click="OnAutoStartChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="{l:Tr app.settings.startPeripheral.title}" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{l:Tr app.settings.startPeripheral.description}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding StartPeripheralOnLaunch, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowMinimize24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="{l:Tr app.settings.keepRunning.title}" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{l:Tr app.settings.keepRunning.description}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon Cursor24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="{l:Tr app.settings.gesture.title}" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{l:Tr app.settings.gesture.description}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:ToggleSwitch x:Name="SwitchGestureToggle" Click="OnSwitchGestureChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage24}" Margin="0,0,0,8">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="{l:Tr app.settings.language.title}" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{l:Tr app.settings.language.description}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ComboBox x:Name="LanguageBox" MinWidth="200" DisplayMemberPath="Name" SelectedValuePath="Code"
                SelectionChanged="OnLanguageChanged" />
    </ui:CardControl>

    <ui:CardControl Icon="{ui:SymbolIcon ArrowExit20}">
      <ui:CardControl.Header>
        <StackPanel>
          <ui:TextBlock Text="{l:Tr app.settings.exit.title}" FontTypography="BodyStrong" />
          <ui:TextBlock FontTypography="Caption" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{l:Tr app.settings.exit.description}" />
        </StackPanel>
      </ui:CardControl.Header>
      <ui:Button Content="{l:Tr app.common.exit}" Click="OnExit" />
    </ui:CardControl>

  </StackPanel>
</Page>
